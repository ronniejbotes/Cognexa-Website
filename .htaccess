# .htaccess — Cognexa marketing site (Hostinger, Apache/LiteSpeed)
#
# Five concerns only:
#   0. Never serve internal repo files (docs, SEO notes, scripts)
#   1. One-hop canonical redirect to https://cognexa.co.za/
#   2. Text compression (mod_deflate)
#   3. Browser caching (mod_expires)
#   4. Security headers (mod_headers) — HSTS, nosniff, framing, referrer, permissions
#
# Keep this file lean — it is read on every request.

# ------------------------------------------------------------------
# 0. Never serve internal repo files.
#
# Every tracked file in this repo reaches public_html, so without this
# block the site served CLAUDE.md, README.md, DNS-EMAIL-SETUP.md, the
# Apps Script, package.json and the whole seo/ strategy folder to anyone
# (found with curl on 2026-09-15).
#
# RedirectMatch 404 answers with a real 404 and the branded page (1c),
# not a 403 that confirms the file exists — the same rule Position Xero
# already runs on Hostinger. The FilesMatch block is an untested second
# layer (no probe has shown Hostinger enforcing it), so never remove the
# RedirectMatch lines on the strength of it.
#
# Dot-paths (.git, .gitignore, .gitkeep, .claude, .env) are blocked;
# /.well-known/ stays open because SSL certificate renewal uses it.
# llms.txt, robots.txt and sitemap.xml match nothing here. A new public
# file of a blocked type (e.g. a pricing.md) needs an explicit exception.
# ------------------------------------------------------------------
RedirectMatch 404 ^/seo(/|$)
RedirectMatch 404 /\.(?!well-known(/|$))
RedirectMatch 404 \.(md|gs|log|bak|sql|sh|ya?ml|lock)$
RedirectMatch 404 ^/package(-lock)?\.json$
<FilesMatch "\.(md|gs|log|bak|sql|sh|ya?ml|lock)$">
  Require all denied
</FilesMatch>

# ------------------------------------------------------------------
# 1. Canonical redirect — exactly ONE hop.
#
# Any of these variants:
#   http://cognexa.co.za/...      (HTTPS off)
#   http://www.cognexa.co.za/...  (HTTPS off + www)
#   https://www.cognexa.co.za/... (www)
# 301s DIRECTLY to https://cognexa.co.za/<path> in a single redirect.
# The two conditions are OR-ed so one rule handles every combination —
# this avoids the chained http→https→non-www double redirect that
# Lighthouse flags under "Avoid multiple page redirects".
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://cognexa.co.za/$1 [R=301,L]

  # ----------------------------------------------------------------
  # 1b. Retired slugs.
  #
  # 2026-08-09: the IVR three-way comparison was retargeted to the
  # comparison buyers actually search for (AI vs human receptionist).
  # Google had never fetched the old URL, so this 301 costs nothing —
  # it exists only so any external copy of the link still resolves.
  # ----------------------------------------------------------------
  RewriteRule ^ai-voice-agent-vs-ivr-vs-receptionist\.html$ /ai-receptionist-vs-human-receptionist.html [R=301,L]

  # Extensionless addresses, e.g. /ai-receptionist-south-africa -> /ai-receptionist-south-africa.html
  # (2026-10-19, plan T-69). No dot is allowed, so it cannot reach the internal files in section 0.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ https://cognexa.co.za/$1.html [R=301,L]
</IfModule>

# ------------------------------------------------------------------
# 1c. Branded error document.
#
# Without this, Hostinger serves its own generic 404 — no branding,
# no navigation, and no links back into the site, so every crawler
# and visitor that hits a bad URL is a dead end.
# The status code stays 404; a 200 here would be a soft-404, which is
# worse than the default page.
# ------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------
# 2. Compression — gzip the text formats this static site serves.
# (JPG and MP4 are already compressed; compressing them again wastes CPU,
# so only text types are listed. SVG is XML text, hence included.)
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# 3. Browser caching.
#   - HTML: no caching (max-age=0) — pages must update the moment we deploy,
#     and they are the entry point that references versioned assets.
#   - CSS/JS: 1 year — safe because every reference carries a version: ?v= on
#     css/ and js/, the release in the file name on assets/vendor/. Changed a
#     CSS or JS file? Bump its ?v= on every page that loads it, or returning
#     visitors keep the old copy for a year.
#   - Images / fonts / videos: 30 days — large, rarely-changed media.
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — always revalidate
  ExpiresByType text/html "access plus 0 seconds"

  # CSS/JS — 1 year (versioned URLs, see above)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Images — 30 days
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"

  # Fonts — 30 days (self-hosted woff2; immutable files)
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType font/woff "access plus 30 days"

  # Videos — 30 days
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>

# The host answers JS as application/x-javascript, which the ExpiresByType line
# above does not name. This header covers it, and is the block that already works
# on Austek's site on this host and CDN (checked live 5 Nov 2026).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------
# 4. Security headers.
#   HSTS — tells browsers to always use HTTPS for this domain (and
#   subdomains) for one year. Only meaningful on HTTPS responses;
#   browsers ignore the header over plain HTTP, so setting it
#   unconditionally is safe.
#   The other four (12 Nov 2026) are the same lines as positionxero.com's
#   on this host. They change nothing a visitor sees: no sniffing of file
#   types, no framing by other sites, only the domain (not the full
#   address) sent to other sites as the referrer, and no camera,
#   microphone or location access.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
